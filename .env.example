# Meta WhatsApp Cloud API credentials
WHATSAPP_ACCESS_TOKEN=your_permanent_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_API_VERSION=v21.0

# Facebook Page (for listing posts / creating ads from organic posts)
META_PAGE_ID=your_facebook_page_id
META_PAGE_ACCESS_TOKEN=your_page_access_token_or_leave_blank_to_reuse_whatsapp_token

# Instagram (for listing IG media / creating IG ads)
META_INSTAGRAM_ACCOUNT_ID=your_ig_business_account_id
